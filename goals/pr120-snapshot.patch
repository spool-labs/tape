+        let public = public_track();
+        let mut restricted = public;
+        restricted.visibility = TrackVisibility::Restricted as u64;
+
+        assert_ne!(public.get_hash(), restricted.get_hash());
+        assert!(restricted.is_restricted());
+    }
+
+    // packing round-trips every field
+    #[test]
+    fn pack_roundtrip() {
+        let mut track = public_track();
+        track.visibility = TrackVisibility::Restricted as u64;
+
+        let restored = CompressedTrack::unpack(track.pack());
+
+        assert_eq!(track, restored);
+    }
+}
