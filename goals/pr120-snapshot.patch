+/// Admit a restricted object read for a caller the operator's policy maps to the bucket.
+///
+/// A read check, so it neither reserves budget nor consults the write kill switch.
+pub fn authorize_restricted_read<Db, Cluster, Blockchain>(
+    state: &AppState<Db, Cluster, Blockchain>,
+    auth: &Auth,
+    bucket: Address,
+) -> Result<(), S3Error>
+where
+    Db: Store,
+    Cluster: Api,
+    Blockchain: Rpc,
+{
+    decide_restricted_read(
+        state.context.store.as_ref(),
+        bootstrap_access_key_id(state),
+        auth,
+        bucket,
+    )
