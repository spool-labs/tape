+++ b/tools/tape/src/commands/grant.rs
@@ -0,0 +1,114 @@
+//! `tape grant` — issue a read grant for a restricted object; `tape revoke-grants` revokes them all.
+
+use std::path::Path;
+use std::str::FromStr;
+use std::time::Duration;
+
+use serde::Serialize;
+use tape_core::types::tls::NetworkTlsPubkey;
+use tape_crypto::address::Address;
+use tape_crypto::hash::hash;
+use tape_protocol::api::encode_read_grant;
+
+use crate::cassette;
+use crate::context::Context;
+use crate::error::{Error, Result};
+use crate::output::CliOutput;
+
+/// Grant lifetime in seconds when `--ttl` is omitted
+const DEFAULT_GRANT_TTL_SECS: u64 = 24 * 60 * 60;
+
+/// What a tape-wide grant reports where a one-object grant reports its name.
+const ALL_TRACKS_NAME: &str = "(all tracks)";
+
+#[derive(Serialize)]
+pub struct GrantOutput {
+    pub bucket_address: String,
+    pub name: String,
+    pub reader: String,
+    pub expires_in_secs: u64,
+    pub grant: String,
+}
+
+impl CliOutput for GrantOutput {
+    fn print_text(&self) {
+        println!("bucket address:   {}", self.bucket_address);
+        println!("name:             {}", self.name);
+        println!("reader:           {}", self.reader);
+        println!("expires in:       {}s", self.expires_in_secs);
+        println!("read grant:       {}", self.grant);
+    }
+}
+
+#[derive(Serialize)]
+pub struct RevokeGrantsOutput {
+    pub bucket_address: String,
+}
+
+impl CliOutput for RevokeGrantsOutput {
+    fn print_text(&self) {
+        println!("bucket address:   {}", self.bucket_address);
+        println!("every outstanding read grant is revoked");
+    }
+}
+
+pub async fn issue(
+    ctx: &Context,
+    cassette_flag: Option<&Path>,
+    name: Option<&str>,
+    is_all_tracks: bool,
+    reader: &str,
+    ttl_secs: Option<u64>,
+) -> Result<GrantOutput> {
+    let cassette_path = ctx.require_cassette(cassette_flag)?;
+    let tape_key = cassette::load(&cassette_path)?;
+    let sdk = ctx.sdk()?;
+
+    let ttl_secs = ttl_secs.unwrap_or(DEFAULT_GRANT_TTL_SECS);
+    let reader_pubkey = parse_reader(reader)?;
+    let ttl = Duration::from_secs(ttl_secs);
+    let issued = match (is_all_tracks, name) {
+        (true, _) => sdk
+            .issue_tape_read_grant(&tape_key, reader_pubkey, ttl)
+            .await
+            .map_err(|e| Error::Sdk(format!("issue_tape_read_grant: {e}")))?,
+        (false, Some(name)) => sdk
+            .issue_read_grant(&tape_key, hash(name.as_bytes()), reader_pubkey, ttl)
+            .await
+            .map_err(|e| Error::Sdk(format!("issue_read_grant: {e}")))?,
+        (false, None) => {
+            return Err(Error::Invalid(
+                "name an object or pass --all-tracks".to_string(),
+            ));
+        }
+    };
+
+    Ok(GrantOutput {
+        bucket_address: tape_key.address().to_string(),
+        name: name.unwrap_or(ALL_TRACKS_NAME).to_string(),
+        reader: reader.to_string(),
+        expires_in_secs: ttl_secs,
+        grant: encode_read_grant(&issued),
+    })
+}
+
+pub async fn revoke_all(ctx: &Context, cassette_flag: Option<&Path>) -> Result<RevokeGrantsOutput> {
+    let cassette_path = ctx.require_cassette(cassette_flag)?;
+    let tape_key = cassette::load(&cassette_path)?;
+    let sdk = ctx.sdk()?;
+
+    sdk.bump_grant_generation(&tape_key)
+        .await
+        .map_err(|e| Error::Sdk(format!("bump_grant_generation: {e}")))?;
+
+    Ok(RevokeGrantsOutput {
+        bucket_address: tape_key.address().to_string(),
+    })
+}
+
+fn parse_reader(reader: &str) -> Result<NetworkTlsPubkey> {
+    let address = Address::from_str(reader)
+        .map_err(|e| Error::Invalid(format!("invalid reader tls pubkey: {e}")))?;
+
+    Ok(NetworkTlsPubkey::new(address.to_bytes()))
+}
